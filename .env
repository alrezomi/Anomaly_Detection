# Host paths. Relative paths are resolved from this compose.yaml directory.
ANOMALY_DATA_DIR=~/projects/steribot/rosbags/data_acquisition/test_Alireza
ANOMALY_OUTPUT_DIR=~/projects/AD/outputs

# Local configuration file mounted read-only into the container.
PIPELINE_CONFIG_FILE=./pipeline_config.json

# Keeps this Compose application's resources separate from other projects.
COMPOSE_PROJECT_NAME=anomaly-detection


STAGE_STARTUP_IGNORE_SEC=0.1