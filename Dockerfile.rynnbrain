# Initial x86_64 CUDA test image. Jetson requires a JetPack-compatible base.
ARG RYNNBRAIN_BASE_IMAGE=nvcr.io/nvidia/pytorch:25.08-py3
FROM ${RYNNBRAIN_BASE_IMAGE}

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HF_HOME=/cache/huggingface

WORKDIR /workspace/anomaly_detection

COPY requirements-rynnbrain.txt ./requirements-rynnbrain.txt
RUN python -m pip install --no-cache-dir -r requirements-rynnbrain.txt

COPY . .

ENTRYPOINT ["python", "-m", "rynnbrain_vlm.run"]
CMD ["--config", "/config/pipeline_config.json"]
